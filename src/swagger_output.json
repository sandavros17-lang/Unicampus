    "/api/cursos/": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Listar cursos activos",
        "description": "Obtiene todos los cursos que están activos.",
        "responses": {
          "200": {
            "description": "Lista de cursos obtenida exitosamente"
          }
        }
      },
      "post": {
        "tags": [
          "Cursos"
        ],
        "summary": "Crear un curso",
        "description": "Registra un nuevo curso.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "Datos del nuevo curso",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "codigoCurso": {
                  "type": "string",
                  "example": "INF101"
                },
                "nombreMateria": {
                  "type": "string",
                  "example": "Programación I"
                },
                "creditos": {
                  "type": "number",
                  "example": 5
                },
                "profesorId": {
                  "type": "number",
                  "example": 1
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Curso creado exitosamente"
          },
          "400": {
            "description": "Datos inválidos"
          }
        }
      }
    },
    "/api/cursos/{id}": {
      "get": {
        "tags": [
          "Cursos"
        ],
        "summary": "Buscar curso por ID",
        "description": "Busca un curso activo utilizando su ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID del curso"
          }
        ],
        "responses": {
          "200": {
            "description": "Curso encontrado"
          },
          "400": {
            "description": "ID inválido"
          },
          "404": {
            "description": "Curso no encontrado"
          }
        }
      },
      "put": {
        "tags": [
          "Cursos"
        ],
        "summary": "Actualizar un curso",
        "description": "Actualiza los datos de un curso activo.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "description": "ID del curso"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Datos actualizados del curso",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "codigoCurso": {
                  "type": "string",
                  "example": "INF102"
                },
                "nombreMateria": {
                  "type": "string",
                  "example": "Programación II"
                },
                "creditos": {
                  "type": "number",
                  "example": 5
                },
                "profesorId": {
                  "type": "number",
                  "example": 2
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Curso actualizado exitosamente"
          },
          "400": {
            "description": "Datos inválidos"
          },
          "404": {
            "description": "Curso no encontrado"
          }
        }
      }
    },
